{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psor.eu/spec/semantic-contract/1.0-draft.1/schema/promotion-receipt.schema.json",
  "title": "PSOR Promotion Receipt 1.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "recordId",
    "semanticContract",
    "coverageProfile",
    "candidateIds",
    "validationPaths",
    "assuranceLevel",
    "contractValidation",
    "unresolvedMaterialIds",
    "canonicalization",
    "semanticDigest",
    "promotedAt"
  ],
  "properties": {
    "receiptId": { "type": "string", "minLength": 1 },
    "recordId": { "type": "string", "pattern": "^csr:sha256:[0-9a-f]{64}$" },
    "semanticContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "psor-semantic-contract" },
        "version": { "const": "1.0.0-draft.1" }
      }
    },
    "coverageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "candidateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "validationPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "independenceGroup", "version", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["llm", "parser", "rule", "human", "schema", "hybrid"]
          },
          "independenceGroup": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "result": { "const": "passed" }
        }
      }
    },
    "assuranceLevel": { "enum": ["A1", "A2", "A3"] },
    "contractValidation": { "const": "passed" },
    "unresolvedMaterialIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digestAlgorithm"],
      "properties": {
        "algorithm": { "const": "psor-draft-json-v1" },
        "digestAlgorithm": { "const": "sha-256" }
      }
    },
    "semanticDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "promotedAt": { "type": "string", "format": "date-time" }
  }
}